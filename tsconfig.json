{
  "include": [
    "src/**/*",
    "src/.server/**/*",
    "src/.client/**/*",
    ".react-router/types/**/*",
    "*.ts",
    "*.js"
, "src/app/root.tsx"  ],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage",
    ".react-router"
  ],
  "compilerOptions": {
    // "baseUrl": ".",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "types": ["vite/client"],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "rootDirs": [".", "./.react-router/types"],
    // check "rootDir" | "outDir"
    "paths": {
      "@app/*": ["./src/app/*"],
      "@pages/*": ["./src/pages/*"],
      "@features/*": ["./src/features/*"],
    },
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true
    // "sourceMap": true // позволяет отладку TS в браузере
  }
}
